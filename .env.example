# 拾光赞美诗 - 配置清单
# 注意：微信小程序不会读取本文件，这里只列出需要配置的项目
# 请把实际的值分别填到注释里写的文件中，不要填在本文件里

# 微信小程序 AppID → 填入 project.config.json
MINIPROGRAM_APPID=your-appid-here

# 云开发环境 ID → 填入 app.js、utils/cloud-sync.js、project.config.json
CLOUD_ENV_ID=your-cloud-env-id-here

# DashScope API Key → 不要写在小程序前端！请配置在云函数的环境变量里
DASHSCOPE_API_KEY=sk-your-api-key-here

# 后端 API 地址 → 填入 config/index.js
API_URL=https://your-backend-api.com

# 管理员账号密码 → 配置在云函数 churchAdmin 的环境变量里
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here